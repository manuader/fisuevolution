            "state" : "translated",
            "value" : "Nene, ayudame con las bolsas del súper que me duele la cintura."
          }
        }
      }
    },
    "visit.vendedor_ofertas.ask" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pick a boost and watch a video: it's yours."
          }
