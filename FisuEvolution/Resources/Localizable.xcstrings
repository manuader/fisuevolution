      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The elevator is now a button panel. The display shows your floor; tap it to travel."
          }
        },
        "es" : {
          "stringUnit" : {
