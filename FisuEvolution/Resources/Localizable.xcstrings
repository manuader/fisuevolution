    "tutorial.tour.side_rail" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Prizes” holds the Wheel (with one daily spin allowance), the Mattress, the Packages and the video boost. The mattress and the boxes drop onto the board: tap them there to open them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En «Premios» están la Ruleta (con un cupo de giros por día), el Colchón, los Paquetes y el boost por video. El colchón y las cajas caen al tablero: tocalos ahí para abrirlos."
          }
        }
      }
    },
    "tutorial.tour.upgrades" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upgrades now has three tabs: Characters, Permanent and Boosts. You spend Blue there; the Store is now only for real-money purchases."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejoras ahora tiene tres pestañas: Personajes, Permanentes y Boosts. El blue se gasta ahí; la Tienda quedó sólo para compras con plata de verdad."
          }
        }
      }
    },
    "tutorial.tour.visitors" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Characters now walk onto the board and talk in a speech bubble: tap their face to see the deal. Events arrive with a face and a countdown. I'll introduce them when they show up."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora te visitan personajes que entran al tablero y hablan en un globo: tocá su cara para ver el trato. Los eventos llegan con cara y cuenta regresiva. Te los presento cuando aparezcan."
          }
        }
      }
    },
