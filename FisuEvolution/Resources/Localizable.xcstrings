            "value" : "Cada evento deja acá la cara de quien lo trajo. Tocala para ver qué cambia y cómo zafar."
          }
        }
      }
    },
    "tutorial.tip.gifts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gifts holds everything you can collect, what's coming soon and your daily streak. Drop by every day to grab yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En Regalos está todo lo que podés cobrar, lo que llega pronto y la racha diaria. Pasá todos los días a buscar el tuyo."
          }
        }
      }
    },
    "tutorial.tip.mattress" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your workers stashed cash in the mattress. Tap it here: watch a video and it drops onto the board, where you open it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus empleados escondieron plata en el colchón. Tocalo acá: con un video cae al tablero y lo abrís ahí."
          }
        }
      }
    },
    "tutorial.tip.merge_all_video" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lots of duplicates? Tap here: one video merges the whole floor at once."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Muchos repetidos? Tocá acá: con un video se fusiona todo el piso de una."
          }
        }
      }
    },
    "tutorial.tip.packages" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You won a Customs Package! It's a box with a surprise employee inside: tap its seal and open it now."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Ganaste un Paquete de la Aduana! Es una caja con un empleado sorpresa adentro: tocá su sello y abrilo ahora."
          }
        }
      }
    },
    "tutorial.tip.share" : {
      "extractionState" : "manual",
      "localizations" : {
