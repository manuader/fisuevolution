<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- F6: este archivo se referencia desde project.yml (CODE_SIGN_ENTITLEMENTS)
	     recién cuando exista la cuenta paga y los flags se enciendan. Hasta
	     entonces existe pero no participa del build. -->
	<key>com.apple.developer.game-center</key>
	<true/>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.manuader.fisuevolution</string>
	</array>
</dict>
</plist>
