    "tutorial.tour.gifts" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gifts now sorts everything by status: what you can collect now, what's coming soon and what comes later. Chests open with three taps."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regalos ahora ordena todo por estado: lo que ya podés cobrar, lo que llega pronto y lo que viene después. Los cofres se abren con tres toques."
          }
        }
      }
    },
    "tutorial.tour.intro" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
