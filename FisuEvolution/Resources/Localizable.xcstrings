      }
    },
    "visit.vendor.offended.1" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fine, fine! Don't come crying to me when your mate runs out…"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Bueno, bueno! Después no vengas llorando cuando se te acabe el mate…"
          }
        }
      }
    },
    "visit.vendor.offended.2" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oh, look at you. Not even a free boost. See you around, then!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ah, mirá vos. Ni un boost de regalo. ¡Que te vaya bien, eh!"
          }
        }
      }
    },
    "visit.vendor.offended.3" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
