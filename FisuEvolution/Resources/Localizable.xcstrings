    },
    "visit.vendedor_ofertas.bubble" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Get it, get it! Fresh boosts, right out of the oven. Watch a video and it's yours."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Llevá, llevá! Boost calentito, recién salido del horno. Con video te lo regalo."
          }
